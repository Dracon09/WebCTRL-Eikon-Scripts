    useNamingRules: true
]

if (prefsFile.exists()) {
    try {
        def slurper = new JsonSlurper()
        def saved = slurper.parse(prefsFile)
        if (saved.mainDisplayName != null) defaultPrefs.mainDisplayName = saved.mainDisplayName
        if (saved.mainRefName != null) defaultPrefs.mainRefName = saved.mainRefName
        if (saved.mainLabel != null) defaultPrefs.mainLabel = saved.mainLabel
        if (saved.networkPath != null) defaultPrefs.networkPath = saved.networkPath
        if (saved.refPrefix != null) defaultPrefs.refPrefix = saved.refPrefix
        if (saved.useNamingRules != null) defaultPrefs.useNamingRules = saved.useNamingRules
        if (saved.config) {
            saved.config.each { k, v -> CONFIG[k] = v }
        }
    } catch (Throwable ignore) { /* Failed to parse JSON, use defaults */ }
}

