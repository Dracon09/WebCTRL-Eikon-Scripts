// =============================================================
// Map an Integer (0-100) to State Values (Base + Instances)
// - Script-relative paths (prefers <base>\extra or \extras)
// - Regex-safe replacements (literal)
// - TABS: "Values" (default), "Alarm", "Trend", and "Config"
// - UI: Added Main Display Name, Main Reference Name, Label, Network Path
// - LOGIC: Places base symbol, then loops 0-100 placing instance symbols
// - LOGIC: Auto-increments trip points dynamically by tracking newly added blocks
// - LOGIC: Leaves A001 labels intact for alarm rollups
// - SAVES UI state to integer_mapper_prefs.json
// =============================================================

def CONFIG = [
    // --- ALARM CONFIGURATION ---
    enableAlarms      : true,
    potentialSource   : true,             // [Potential alarm source]
    isCritical        : true,             // [Critical]
    alarmCategory     : "hvac_critical",  // [Category] use approved tokens
    alarmEnabled      : 1,                // [Alarm Enable] (1 or 0 / true or false)
    delaySeconds      : 0,                // [Delay Seconds]
    alarmText         : "\$source\$ is in an alarm state of \$new_state\$.",             // [Alarm Text]
    alarmAckRequired  : false,            // [Alarm requires acknowledge]
    returnEnabled     : 0,                // [Return Enabled]
    returnText        : "\$source\$ has returned to a normal state of \$new_state\$.", // [Return Text]
    returnAckRequired : false,            // [Return requires acknowledge]

    // --- TREND CONFIGURATION ---
    enableTrends      : true,
    enableLog         : true,             // [Enable Trend Log]
    sampleOnCOV       : true,             // [Sample on COV]
    sampleInterval    : 300000,           // [Sample every] ms
    maxSamples        : 100,              // [Max samples]
    enableHistorian   : true,             // [Enable Trend Historian]
    keepHistoryDays   : 0,                // [Keep historical trends for]
    useDefaultThresh  : true,             // [Use default (45% of Max samples)]
    writeEverySamples : 45                // [Write to historian every N samples]
]

