// =============================================================
// BACnet MSV Mapping (GUI Edition)
// V3.3.0 - Pre-Scan Isolation & Reference Name UI
// - STABLE: Strict code preservation (Step 1 & Step 2 blocks intact)
// - FIX: Added Pre-Scan step to isolate global counters (math starts fresh on multiple drops)
// - UI: Replaced Object ID with single Network Path field + Clickable Examples
// - UI: Replaced 'Object_Name' with 'Display Name' and dynamic 'Reference Name' field
// - UI: Added top Menu Bar to open and reload NamingRules.csv directly
// - UI: Added 'Len' column to track string length in real-time
// - ENFORCE: Highlights cells red if length > 20 (truncates only on execution)
// - FIX: Removed custom keyboard trap to restore native multi-cell copy/paste
// - NEW: Zero-width space (\u200B) padding for stacked MSVs to prevent text cascading
// - MATH: Auto-scales subtraction blocks (-18.0, -36.0) for 19-state chunks
// - LABELS: Dynamically renames MSV text-figures (MSV1 1-19, MSV2 20-37, etc.)
// - FIX: Prevents protocol string doubling (bacnet://...) during text-figure replacement
// =============================================================

import javax.swing.*
import javax.swing.table.*
import java.awt.*
import java.awt.event.*
import java.awt.datatransfer.*
import java.net.URLDecoder
import java.util.regex.Pattern
import java.util.regex.Matcher

// ==========================================
// FILE & PATH RESOLUTION
// ==========================================
def getBaseDir = {
    try {
        def url = getClass().protectionDomain?.codeSource?.location
        if (url != null) {
            def p = URLDecoder.decode(url.path, "UTF-8")
            File loc = new File(p)
            if (loc.isFile()) return loc.parentFile
            if (loc.isDirectory()) return loc
        }
    } catch (Throwable ignore) {}
    try {
        def wd = System.getProperty("user.dir")
        if (wd) {
            File f = new File(wd)
            if (f.exists()) return f
        }
    } catch (Throwable ignore) {}
    return new File(".").canonicalFile
}()

def candidateDirs = {
    def list = []
    def base = getBaseDir
    def parent = base?.parentFile
    list << base
    list << new File(base, "extra")
    list << new File(base, "extras")
    if (parent != null) {
        list << parent
        list << new File(parent, "extra")
        list << new File(parent, "extras")
    }
    try {
        def wd = System.getProperty("user.dir", ".")
        list << new File(wd)
    } catch (Throwable ignore) {}
    list << new File(".")
    return list.findAll { it != null }
               .collect { it.canonicalFile }
               .unique()
}()

def resolveAsset = { String fileName ->
    for (File dir : candidateDirs) {
        File f = new File(dir, fileName)
        if (f.exists()) return f
    }
    File preferred = new File(getBaseDir, "extra")
    if (!preferred.exists()) preferred = new File(getBaseDir, "extras")
    if (!preferred.exists()) preferred = getBaseDir
    return new File(preferred, fileName)
}

// Logic Symbol Assets for BACnet
def symbolBase   = resolveAsset("bacnet_1_to_msv.logicsymbol")
def symbol1_20   = resolveAsset("bacnet_1_to_20_msv.logicsymbol")
def symbolOver20 = resolveAsset("bacnet_1_to_over_20_msv.logicsymbol")
def csvFile      = resolveAsset("NamingRules.csv")

// ==========================================
// UI CONTROLS & HELPERS
// ==========================================
JTextField txtDisplayName   = new JTextField("A1_Point", 15)
JTextField txtReferenceName = new JTextField("a1_point", 15)
JTextField txtNetworkPath   = new JTextField("MSV:147", 10)
JCheckBox  chkUseRules      = new JCheckBox("Use Naming Rules", true)

def makeRefSafe = { String s ->
    if (!s) return ""
    s = s.toLowerCase()
         .replaceAll(/[^a-z0-9]/, '_')
         .replaceAll(/__+/, '_')
         .replaceAll(/^_|_$/, '')
    if (s.matches("^\\d.*")) s = "_" + s
    return s 
}

def shortenMap = [:]
def loadNamingRules = {
    shortenMap.clear()
    if (csvFile.exists()) {
        csvFile.eachLine { line ->
            if (!line?.trim() || line.startsWith("#")) return
            def p = line.split(',')
            if (p.size() == 2) shortenMap.put(p[0].trim(), p[1].trim())
        }
    }
}
loadNamingRules()

// Applies CSV rules (leaves >20 chars intact to trigger UI highlighting)
def eikonFormatStateText = { String str ->
    if (!str) return ""
    def s = str
    if (chkUseRules.isSelected()) {
        shortenMap.each { k, v ->
            s = s.replaceAll("(?i)\\b" + Pattern.quote(k) + "\\b", Matcher.quoteReplacement(v))
        }
    }
    return s.trim()
}

// Dynamic Reference Name Updater
def updateRefField = {
    SwingUtilities.invokeLater({
        def base = txtDisplayName.getText()
        if (chkUseRules.isSelected()) {
            shortenMap.each { k, v ->
                base = base.replaceAll("(?i)\\b" + Pattern.quote(k) + "\\b", Matcher.quoteReplacement(v))
            }
        }
        txtReferenceName.setText(makeRefSafe(base))
    })
}

txtDisplayName.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
    void insertUpdate(javax.swing.event.DocumentEvent e) { updateRefField() }
    void removeUpdate(javax.swing.event.DocumentEvent e) { updateRefField() }
    void changedUpdate(javax.swing.event.DocumentEvent e) { updateRefField() }
})

// ==========================================
// GUI TABLE SETUP
// ==========================================
class EikonCellRenderer extends DefaultTableCellRenderer {
    @Override
    Component getTableCellRendererComponent(JTable table, Object value, boolean isSelected, boolean hasFocus, int row, int col) {
        Component c = super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, col)
        c.setBackground(isSelected ? table.getSelectionBackground() : Color.WHITE)
        c.setForeground(isSelected ? table.getSelectionForeground() : Color.BLACK)
        
        // Highlight BACnet text and length column if over 20 chars
        if (col == 2 && value?.toString()?.length() > 20) {
            c.setBackground(new Color(255, 100, 100))
        }
        if (col == 3 && value != null && value.toString().length() > 0) {
            try {
                if (Integer.parseInt(value.toString()) > 20) {
                    c.setBackground(new Color(255, 100, 100))
                }
            } catch (Exception ex) {}
        }
        return c
    }
}

int MAX_STATES = 1000
def columnNames = ["Value", "Raw State Text", "BACnet Text", "Len"]
// Initialize table with values 1 through 1000
def data = (1..MAX_STATES).collect { [it.toString(), "", "", ""] } as Object[][]
DefaultTableModel model = new DefaultTableModel(data, columnNames as Object[]) { 
    @Override boolean isCellEditable(int r, int c) { return c != 0 && c != 3 } 
}
JTable table = new JTable(model)
table.setDefaultRenderer(Object.class, new EikonCellRenderer())
table.setRowHeight(22)
table.getColumnModel().getColumn(0).setMaxWidth(50)
table.getColumnModel().getColumn(3).setMaxWidth(40)
table.setCellSelectionEnabled(true)

// COPY/PASTE HANDLER (Native copy preserved)
table.addKeyListener(new KeyAdapter() {
    @Override
    void keyPressed(KeyEvent e) {
        int mask
        try { mask = Toolkit.getDefaultToolkit().getMenuShortcutKeyMaskEx() }
        catch (Throwable t) { try { mask = Toolkit.getDefaultToolkit().getMenuShortcutKeyMask() } catch (Throwable t2) { mask = java.awt.event.InputEvent.CTRL_DOWN_MASK } }
        
        if ((e.getModifiersEx() & mask) != 0 && e.getKeyCode() == KeyEvent.VK_V) {
            int rStart = table.getSelectedRow() == -1 ? 0 : table.getSelectedRow()
            int cStart = table.getSelectedColumn() == -1 ? 1 : table.getSelectedColumn()
            try {
                String cb = (String) Toolkit.getDefaultToolkit().getSystemClipboard().getContents(null).getTransferData(DataFlavor.stringFlavor)
                cb.split("\\r?\\n").eachWithIndex { line, i ->
                    if (!line?.trim()) return
                    if ((rStart + i) < MAX_STATES) {
                        String[] cells = line.split("\t")
                        cells.eachWithIndex { val, j ->
                            if ((cStart + j) == 1 || (cStart + j) == 2) {
                                model.setValueAt((val == null) ? "" : val.trim(), rStart + i, cStart + j)
                            }
                        }
                    }
                }
            } catch (Exception ex) { /* ignore */ }
            e.consume()
        }
    }
})

// Auto-fill BACnet Text & Length from Raw State Text
model.addTableModelListener({ e ->
    int c = e.getColumn()
    if (c == 1 || c == 2) {
        int r = e.getFirstRow()
        Object val = model.getValueAt(r, c)
        SwingUtilities.invokeLater({
            if (c == 1) {
                String formatted = eikonFormatStateText(val?.toString())
                model.setValueAt(formatted, r, 2)
            } else if (c == 2) {
                int len = val ? val.toString().length() : 0
                model.setValueAt(len > 0 ? len.toString() : "", r, 3)
            }
        })
    }
} as javax.swing.event.TableModelListener)

// Reapply rules to all rows when toggled
def reapplyRules = {
    for (int i = 0; i < MAX_STATES; i++) {
        def rObj = model.getValueAt(i, 1)
        if (rObj) {
            model.setValueAt(eikonFormatStateText(rObj.toString()), i, 2)
        }
    }
}

chkUseRules.addItemListener({ evt -> 
    reapplyRules() 
    updateRefField()
} as java.awt.event.ItemListener)

// ==========================================
// GUI LAYOUT & MENUS
// ==========================================
JTextArea statusLabel = new JTextArea("Ready\nAssets Dir: " + getBaseDir?.absolutePath, 4, 50)
statusLabel.setEditable(false); statusLabel.setBackground(new Color(240, 240, 240))

// MENU SETUP
JMenuBar menuBar = new JMenuBar()
JMenu editMenu = new JMenu("Edit")
JMenuItem editCsvItem = new JMenuItem("Edit Naming Rules...")
JMenuItem reloadCsvItem = new JMenuItem("Reload Naming Rules")

editCsvItem.addActionListener({ 
    if (csvFile.exists()) Desktop.getDesktop().edit(csvFile)
    else JOptionPane.showMessageDialog(null, "File not found: " + csvFile.absolutePath)
} as ActionListener)

reloadCsvItem.addActionListener({ 
    loadNamingRules()
    if (chkUseRules.isSelected()) {
        reapplyRules()
        updateRefField()
        statusLabel.setText("Rules reloaded and applied (Use Naming Rules = ON).")
    } else {
        statusLabel.setText("Rules reloaded (Use Naming Rules = OFF).")
    }
} as ActionListener)

editMenu.add(editCsvItem)
editMenu.add(reloadCsvItem)
menuBar.add(editMenu)

// MAIN TABS
JTabbedPane tabs = new JTabbedPane()
JPanel msvPanel = new JPanel(new BorderLayout(5,5))
