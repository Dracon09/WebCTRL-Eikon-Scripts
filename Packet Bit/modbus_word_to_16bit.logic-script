swapButton.addActionListener({ 
    Object[][] temp = new Object[16][2]; 
    for (int i = 0; i < 16; i++) { 
        temp[i][0] = model.getValueAt(i, 1); 
        temp[i][1] = model.getValueAt(i, 2) 
    }
    for (int i = 0; i < 16; i++) { 
        model.setValueAt(temp[15-i][0], i, 1); 
        model.setValueAt(temp[15-i][1], i, 2) 
    }
} as ActionListener)

fixOCRButton.addActionListener({ 
    for (int i = 0; i < 16; i++) { 
        def obj = model.getValueAt(i, 1)
        String n = (obj == null) ? "" : obj.toString()
        if (n) model.setValueAt(n.replaceAll("(?<=[a-z0-9])(?=[A-Z])", " ").trim(), i, 1) 
    }
} as ActionListener)

clearButton.addActionListener({ 
    for (int i = 0; i < 16; i++) { 
        model.setValueAt("", i, 1); 
        model.setValueAt("", i, 2) 
    } 
} as ActionListener)

cancelButton.addActionListener({ frame.dispose() } as ActionListener)

// --- 11) OK handler ---
okButton.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent eventObj) {
        try {
            applyTabsToConfig() 
                                                                                                            
            def oldR = "898989898" // Fixed template base ID
            def newRaw = networkPathField.getText()?.trim()
            if (!newRaw) { statusLabel.setText("Network Path Required"); return }

            // --- SMART PATH PARSING ---
            String prefix = "Reg"
            String newR = newRaw 

            if (newRaw =~ /(?i)bacnet/ || newRaw =~ /(?i)\/(ai|av|bi|bv|msi|msv|ao|bo|mso)\s*:/) {
                def match = newRaw =~ /(?i)\/(ai|av|bi|bv|msi|msv|ao|bo|mso)\s*:\s*(\d+)/
                if (match) {
                    prefix = match[0][1].toUpperCase()
                    newR = match[0][2]
                }
            } else if (newRaw =~ /(?i)(modbus|mtcpip|mnet)/ || newRaw =~ /(?i)\/(?:uint|int|float|bits?)\/\d+/) {
                def match = newRaw =~ /(?i)\/(?:uint|int|float|bits?)\/(\d{4,6})/
                if (match) {
                    prefix = "Reg"
                    newR = match[0][1]
                }
            }

            String oldDispName  = "Reg " + oldR
            String newDispName  = prefix + " " + newR
            String oldLabelName = "REG" + oldR
            String newLabelName = prefix.toUpperCase() + newR
            String oldNetPath   = "mtcpip://UINT/" + oldR + "/1/xxx.xxx.xxx.xxx"
            String oldRefName   = "reg_" + oldR.toLowerCase()
            String newRefName   = prefix.toLowerCase() + "_" + newR

            String oldPbRef = "pb_" + oldR
            String newPbRef = prefix.equalsIgnoreCase("Reg") ? "pb_" + newR : "pb_" + prefix.toLowerCase() + "_" + newR
            
            String oldPbDisp = "PB " + oldR
            String newPbDisp = prefix.equalsIgnoreCase("Reg") ? "PB " + newR : "PB " + prefix.toUpperCase() + " " + newR

            if (symbolFile?.exists()) {
                logic.append { symbol(symbolFile.absolutePath) { } }
            } else {
                throw new Exception("Symbol file does not exist: " + (symbolFile?.absolutePath ?: "null"))
            }
                                        
            logic.figures { 
                if (getType()=='text-figure' && text != null) {
                    if (text.toLowerCase().contains(oldNetPath.toLowerCase())) {
                        text = replaceAllLiteralIgnoreCase(text, oldNetPath, newRaw)
                    } else if (text.contains(oldLabelName)) {
                        text = replaceAllLiteral(text, oldLabelName, newLabelName)
                    } else if (text.contains(oldDispName)) {
                        text = replaceAllLiteral(text, oldDispName, newDispName)
                    } else if (text.contains(oldPbDisp)) {
                        text = replaceAllLiteral(text, oldPbDisp, newPbDisp)
                    } else if (text.contains(oldR)) {
                        text = replaceAllLiteral(text, oldR, newR)
                    }
                }
            }
            
            logic.labels().each { 
                def nm = it?.name
                if (nm != null && nm.contains(oldR)) {
                    String newName = nm
                    if (newName.contains(oldLabelName)) {
                        newName = replaceAllLiteral(newName, oldLabelName, newLabelName)
                    } else if (newName.contains(oldDispName)) {
                        newName = replaceAllLiteral(newName, oldDispName, newDispName)
                    } else if (newName.contains(oldPbDisp)) {
                        newName = replaceAllLiteral(newName, oldPbDisp, newPbDisp)
                    } else {
                        newName = replaceAllLiteral(newName, oldR, newR)
                    }
                    tracker.stage(it, newName)
                }
            }

            logic.microblocks {
                if (propNames.contains('address')) {
                    def addr = prop.'address'
                    if (addr instanceof String && addr.contains(oldR)) {
                        if (newRaw.contains("://")) {
                            prop.'address' = newRaw // OVERWRITE
                        } else {
                            prop.'address' = replaceAllLiteral(addr, oldR, newRaw)
                        }
                    }
                }
                if (propNames.contains('display name')) {
                    def dn = prop.'display name'
                    if (dn instanceof String && dn.contains(oldR)) {
                        if (dn.contains(oldLabelName)) {
                            prop.'display name' = replaceAllLiteral(dn, oldLabelName, newLabelName)
                        } else if (dn.contains(oldDispName)) {
                            prop.'display name' = replaceAllLiteral(dn, oldDispName, newDispName)
                        } else if (dn.contains(oldPbDisp)) {
                            prop.'display name' = replaceAllLiteral(dn, oldPbDisp, newPbDisp)
                        } else {
                            prop.'display name' = replaceAllLiteral(dn, oldR, newR)
                        }
                    }
                }
                if (propNames.contains('reference name')) {
                    def rn = prop.'reference name'
                    if (rn instanceof String && rn.toLowerCase().contains(oldR.toLowerCase())) {
                        if (rn.toLowerCase().contains(oldRefName)) {
                            prop.'reference name' = makeRefSafe(replaceAllLiteralIgnoreCase(rn, oldRefName, newRefName))
                        } else if (rn.toLowerCase().contains(oldPbRef)) {
                            prop.'reference name' = makeRefSafe(replaceAllLiteralIgnoreCase(rn, oldPbRef, newPbRef))
                        } else {
                            prop.'reference name' = makeRefSafe(replaceAllLiteralIgnoreCase(rn, oldR, newR))
                        }
                    }
                }
                if (propNames.contains('description')) {
                    def ds = prop.'description'
                    if (ds instanceof String && ds.contains(oldR)) {
                        if (ds.contains(oldLabelName)) {
                            prop.'description' = replaceAllLiteral(ds, oldLabelName, newLabelName)
                        } else if (ds.contains(oldDispName)) {
                            prop.'description' = replaceAllLiteral(ds, oldDispName, newDispName)
                        } else if (ds.contains(oldPbDisp)) {
                            prop.'description' = replaceAllLiteral(ds, oldPbDisp, newPbDisp)
                        } else {
                            prop.'description' = replaceAllLiteral(ds, oldR, newR)
                        }
                    }
                }
            }

            tracker.commit()

            for (int i = 0; i < 16; i++) {
                String dName = (model.getValueAt(i, 1) ?: "").toString().trim()
                String rBase = (model.getValueAt(i, 2) ?: "").toString().trim()
                if (!dName) continue

                String hook = newPbRef + "_" + String.format("%02d", i)

                logic.microblocks {
                    if (prop.'reference name'?.contains(hook)) {
                        prop.'display name' = dName
                        if (propNames.contains('description')) prop.'description' = dName
                        
                        if (type == 'event' && CONFIG.enableAlarms) {
                            if (propNames.contains('potential alarm source')) prop.'potential alarm source' = CONFIG.potentialSource
                            if (propNames.contains('critical'))               prop.'critical' = CONFIG.isCritical
                            if (propNames.contains('category'))               try { prop.'category' = CONFIG.alarmCategory } catch(ex) {}
                            if (propNames.contains('alarm enabled')) {
                                def val = CONFIG.alarmEnabled
                                try { prop.'alarm enabled' = val } catch(ex) { try { prop.'alarm enabled' = (val==1) } catch(ex2) { prop.'alarm enabled' = "${val}" } }
                            }
                            if (propNames.contains('delay seconds'))          try { prop.'delay seconds' = (CONFIG.delaySeconds ?: 0) } catch(ex) {}
                            if (CONFIG.alarmText && propNames.contains('alarm text'))   prop.'alarm text' = CONFIG.alarmText
                            if (propNames.contains('alarm requires acknowledge'))       prop.'alarm requires acknowledge' = CONFIG.alarmAckRequired
                            if (propNames.contains('return enabled')) {
                                def rval = CONFIG.returnEnabled
                                try { prop.'return enabled' = rval } catch(ex) { try { prop.'return enabled' = (rval==1) } catch(ex2) { prop.'return enabled' = "${rval}" } }
                            }
                            if (CONFIG.returnText && propNames.contains('return text')) prop.'return text' = CONFIG.returnText
                            if (propNames.contains('return requires acknowledge'))      prop.'return requires acknowledge' = CONFIG.returnAckRequired
                        }
                        
                        if ((type == 'bdt' || type == 'bat') && CONFIG.enableTrends) {
                            if (propNames.contains('enable trend log')) {
                                def lval = CONFIG.enableLog
                                try { prop.'enable trend log' = lval } catch(ex) { try { prop.'enable trend log' = (lval?1:0) } catch(ex2) { prop.'enable trend log' = "${lval?1:0}" } }
                            }
                            if (propNames.contains('enable trend historian')) prop.'enable trend historian' = CONFIG.enableHistorian
                            if (propNames.contains('allocate memory for'))   prop.'allocate memory for' = CONFIG.maxSamples
                            if (propNames.contains('keep historical trends for')) prop.'keep historical trends for' = CONFIG.keepHistoryDays

                            if (propNames.contains('sample on COV')) {
                                try { prop.'sample on COV' = CONFIG.sampleOnCOV } catch (Throwable ignore) {}
                            }
                            if (!CONFIG.sampleOnCOV && propNames.contains('sample every')) {
                                long ms = (CONFIG.sampleInterval ?: 300000) as long
                                long cs = Math.max(0L, Math.round(ms / 10.0d))  
                                try { prop.'sample every' = cs } catch (Throwable ignore) {}
                            }

                            def useDefaultBoolNames = ['use trend notification threshold', 'use default trend notification threshold', 'use default threshold']
                            def writeEveryNumNames = ['write to historian every', 'write to historian', 'trend notification threshold']

                            def setBooleanCompat = { String key, boolean val ->
                                try { prop."${key}" = val } catch (Throwable ex1) {
                                    try { prop."${key}" = (val ? 1 : 0) } catch (Throwable ex2) {
                                        try { prop."${key}" = "${val ? 1 : 0}" } catch (Throwable ex3) { }
                                    }
                                }
                            }
                            def setIntCompat = { String key, int val ->
                                try { prop."${key}" = val } catch (Throwable ex1) {
                                    try { prop."${key}" = (val as Integer) } catch (Throwable ex2) {
                                        try { prop."${key}" = "${val}" } catch (Throwable ex3) { }
                                    }
                                }
                            }

                            def presentUseDefaultKeys = useDefaultBoolNames.findAll { propNames.contains(it) }
                            def presentWriteEveryKeys = writeEveryNumNames.findAll { propNames.contains(it) }

                            if (CONFIG.useDefaultThresh) {
                                presentUseDefaultKeys.each { setBooleanCompat(it, false) }
                            } else {
                                presentUseDefaultKeys.each { setBooleanCompat(it, true) }
                                int _max = 0
                                try { _max = (CONFIG.maxSamples ?: 0) as int } catch (Throwable ignore) {}
                                int _limit = Math.max(0, (int)Math.floor(_max * 0.5d))
                                int _every = 0
                                try { _every = (CONFIG.writeEverySamples ?: 0) as int } catch (Throwable ignore) {}
                                if (_every > _limit) _every = _limit
                                presentWriteEveryKeys.each { setIntCompat(it, _every) }
                            }

                            if (CONFIG.containsKey('activeText') && propNames.contains('active text'))      
                                prop.'active text' = CONFIG.activeText
                            if (CONFIG.containsKey('inactiveText') && propNames.contains('inactive text'))    
                                prop.'inactive text' = CONFIG.inactiveText
                        }

                        String targetSuffix = (type == "bat" || type == "bdt") ? "_tnd" : (type == "event" ? "_alm" : "_bv")
                        if (propNames.contains('reference name')) {
                            String rb = rBase ?: ""
                            String withSfx = rb.endsWith(targetSuffix) ? rb : (rb + targetSuffix)
                            prop.'reference name' = makeRefSafe(withSfx)
                        }
                    }
                }
            }
            
            // --- SAVE PREFERENCES AFTER SUCCESS ---
            try {
                def toSave = [
                    networkPath: networkPathField.getText()?.trim() ?: "",
                    refPrefix: txtPrefix.getText()?.trim() ?: "",
                    useNamingRules: chkUseRules.isSelected(),
                    symbolPath: symbolFile?.absolutePath ?: "",
                    config: CONFIG
                ]
                prefsFile.write(JsonOutput.prettyPrint(JsonOutput.toJson(toSave)))
            } catch (Throwable ignore) { /* Silently fail if unable to write file */ }

            statusLabel.setText("Success: Register ${newR} updated. (Use Naming Rules: ${chkUseRules.isSelected() ? 'ON' : 'OFF'}, Prefix: '${getRefPrefix()}')")
        } catch (Exception ex) { 
            statusLabel.setText("Error: " + (ex?.message ?: ex?.toString()))
        }
    }
})
