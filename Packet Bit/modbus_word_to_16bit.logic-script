// --- 1) FILE & PATH RESOLUTION (Prefer extra/extras; no hardcoding) ---

def getBaseDir = {
    try {
        def url = getClass().protectionDomain?.codeSource?.location
        if (url != null) {
            def p = URLDecoder.decode(url.path, "UTF-8")
            File loc = new File(p)
            if (loc.isFile()) return loc.parentFile
            if (loc.isDirectory()) return loc
        }
    } catch (Throwable ignore) {}
    try {
        def wd = System.getProperty("user.dir")
        if (wd) {
            File f = new File(wd)
            if (f.exists()) return f
        }
    } catch (Throwable ignore) {}
    return new File(".").canonicalFile
}()

def candidateDirs = {
    def list = []
    def base = getBaseDir
    def parent = base?.parentFile
    list << base
    list << new File(base, "extra")
    list << new File(base, "extras")
    if (parent != null) {
        list << parent
        list << new File(parent, "extra")
        list << new File(parent, "extras")
    }
    try {
        def wd = System.getProperty("user.dir", ".")
        list << new File(wd)
    } catch (Throwable ignore) {}
    list << new File(".")
    return list.findAll { it != null }
               .collect { it.canonicalFile }
               .unique()
}()

def resolveAsset = { String fileName ->
    for (File dir : candidateDirs) {
        File f = new File(dir, fileName)
        if (f.exists()) return f
    }
    File preferred = new File(getBaseDir, "extra")
    if (!preferred.exists()) preferred = new File(getBaseDir, "extras")
    if (!preferred.exists()) preferred = getBaseDir
    return new File(preferred, fileName)
}

def csvFile   = resolveAsset("NamingRules.csv")
def prefsFile = resolveAsset("16bit_mapper_prefs.json") // JSON state file

// --- PREFERENCES LOADING ---
def defaultPrefs = [networkPath: "", refPrefix: "", useNamingRules: true, symbolPath: ""]

if (prefsFile.exists()) {
    try {
        def slurper = new JsonSlurper()
        def saved = slurper.parse(prefsFile)
        if (saved.networkPath != null) defaultPrefs.networkPath = saved.networkPath
        if (saved.refPrefix != null) defaultPrefs.refPrefix = saved.refPrefix
        if (saved.useNamingRules != null) defaultPrefs.useNamingRules = saved.useNamingRules
        if (saved.symbolPath != null) defaultPrefs.symbolPath = saved.symbolPath
        if (saved.config) {
            saved.config.each { k, v -> CONFIG[k] = v }
        }
    } catch (Throwable ignore) { /* Failed to parse JSON, use defaults */ }
}

// Determine Symbol File from prefs, fallback to default
File symbolFile = null
if (defaultPrefs.symbolPath?.trim()) {
    File temp = new File(defaultPrefs.symbolPath)
    if (temp.exists()) symbolFile = temp
}
if (symbolFile == null) {
    symbolFile = resolveAsset("modbus_word_to_16bit.logicsymbol")
}

