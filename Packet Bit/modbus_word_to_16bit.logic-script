def loadPreviewImage = { File file, JLabel targetLabel ->
    if (file == null || !file.exists() || !file.name.toLowerCase().endsWith(".logicsymbol")) {
        targetLabel.setIcon(null); targetLabel.setText("No valid symbol file selected")
        return
    }
    try {
        ZipFile zf = new ZipFile(file)
        def entry = zf.getEntry("source/preview.png") ?: zf.getEntry("preview.png")
        if (entry) {
            def is = zf.getInputStream(entry)
            def img = ImageIO.read(is)
            is.close()
            zf.close()
            if (img) {
                int maxW = 500, maxH = 400
                int w = img.getWidth(), h = img.getHeight()
                double scale = Math.min((double)maxW/w, (double)maxH/h)
                if (scale < 1.0) {
                    w = (int)(w * scale); h = (int)(h * scale)
                    img = img.getScaledInstance(w, h, Image.SCALE_SMOOTH)
                }
                targetLabel.setIcon(new ImageIcon(img))
                targetLabel.setText("")
            } else {
                targetLabel.setIcon(null); targetLabel.setText("Preview image not readable")
            }
        } else {
            zf.close()
            targetLabel.setIcon(null); targetLabel.setText("No preview.png found in archive")
        }
    } catch (Exception ex) {
        targetLabel.setIcon(null); targetLabel.setText("Error loading preview: " + ex.message)
    }
}

