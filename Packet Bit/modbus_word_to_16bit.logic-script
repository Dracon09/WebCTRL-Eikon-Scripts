def syncTrendControls = {
    boolean logOn  = chkEnableLog.isSelected()
    boolean histOn = chkEnableHist.isSelected()
    rbInterval.setEnabled(logOn); rbCOV.setEnabled(logOn); txtInterval.setEnabled(logOn && rbInterval.isSelected())
    txtMaxSamples.setEnabled(logOn); lblHHMMSS.setEnabled(logOn); lblMaxHelp.setEnabled(logOn)
    chkEnableHist.setEnabled(logOn); lblKeepDays.setEnabled(logOn && histOn); txtKeepDays.setEnabled(logOn && histOn)
    lblKeepHelp.setEnabled(logOn && histOn); lblWriteHdr.setEnabled(logOn && histOn)
    rbUseEvery.setEnabled(logOn && histOn); rbUseDefault.setEnabled(logOn && histOn)
    txtEvery.setEnabled(logOn && histOn && rbUseEvery.isSelected())
    lblEveryTail.setEnabled(logOn && histOn && rbUseEvery.isSelected())
    lblActiveText.setEnabled(logOn); txtActiveText.setEnabled(logOn)
    lblInactiveText.setEnabled(logOn); txtInactiveText.setEnabled(logOn)
}
[chkEnableLog, chkEnableHist, rbInterval, rbCOV, rbUseEvery, rbUseDefault].each { 
    it.addItemListener({ syncTrendControls() } as java.awt.event.ItemListener) 
}

def numericOnly = { JTextField tf ->
    tf.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
        void changedUpdate(javax.swing.event.DocumentEvent e) {}
        void insertUpdate(javax.swing.event.DocumentEvent e) { fix() }
        void removeUpdate(javax.swing.event.DocumentEvent e) { fix() }
        private void fix() {
            SwingUtilities.invokeLater({
                String s = tf.getText(); if (s == null) return
                String t = s.replaceAll("[^0-9-]", ""); if (!t.equals(s)) tf.setText(t)
            })
        }
    })
}
numericOnly(txtMaxSamples); numericOnly(txtKeepDays); numericOnly(txtEvery)

def clampEvery = {
    try {
        int max = Integer.parseInt(txtMaxSamples.getText().trim())
        int limit = Math.max(0, (int)Math.floor(max * 0.5d))
        int cur = Integer.parseInt(txtEvery.getText().trim())
        if (cur > limit) txtEvery.setText(String.valueOf(limit))
    } catch (Throwable ignore) {}
}
def addChangeListener = { JTextField tf, Closure onChange ->
    tf.getDocument().addDocumentListener(new javax.swing.event.DocumentListener() {
        void insertUpdate(javax.swing.event.DocumentEvent e) { onChange() }
        void removeUpdate(javax.swing.event.DocumentEvent e) { onChange() }
        void changedUpdate(javax.swing.event.DocumentEvent e) { onChange() }
    })
}
addChangeListener(txtMaxSamples, { clampEvery() }); addChangeListener(txtEvery, { clampEvery() })
syncTrendControls(); clampEvery()

