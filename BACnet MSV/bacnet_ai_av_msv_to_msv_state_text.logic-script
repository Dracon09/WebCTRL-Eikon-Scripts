/**
 * EIKON Logic Script - V3.0.0 (BACnet GUI Edition)
 * STABLE - NO CODE REMOVAL
 * Feature: GUI interface for pasting raw state text, applying naming rules, 
 * enforcing 20-character limits, and dynamically stacking symbols.
 */

import javax.swing.*
import javax.swing.table.*
import java.awt.*
import java.awt.event.*
import java.awt.datatransfer.*
import java.net.URLDecoder
import java.util.regex.Pattern
import java.util.regex.Matcher

// ==========================================
// FILE & PATH RESOLUTION
// ==========================================
def getBaseDir = {
    try {
        def url = getClass().protectionDomain?.codeSource?.location
        if (url != null) {
            def p = URLDecoder.decode(url.path, "UTF-8")
            File loc = new File(p)
            if (loc.isFile()) return loc.parentFile
            if (loc.isDirectory()) return loc
        }
    } catch (Throwable ignore) {}
    try {
        def wd = System.getProperty("user.dir")
        if (wd) {
            File f = new File(wd)
            if (f.exists()) return f
        }
    } catch (Throwable ignore) {}
    return new File(".").canonicalFile
}()

def candidateDirs = {
    def list = []
    def base = getBaseDir
    def parent = base?.parentFile
    list << base
    list << new File(base, "extra")
    list << new File(base, "extras")
    if (parent != null) {
        list << parent
        list << new File(parent, "extra")
        list << new File(parent, "extras")
    }
    try {
        def wd = System.getProperty("user.dir", ".")
        list << new File(wd)
    } catch (Throwable ignore) {}
    list << new File(".")
    return list.findAll { it != null }
               .collect { it.canonicalFile }
               .unique()
}()

def resolveAsset = { String fileName ->
    for (File dir : candidateDirs) {
        File f = new File(dir, fileName)
        if (f.exists()) return f
    }
    File preferred = new File(getBaseDir, "extra")
    if (!preferred.exists()) preferred = new File(getBaseDir, "extras")
    if (!preferred.exists()) preferred = getBaseDir
    return new File(preferred, fileName)
}

// Logic Symbol Assets for BACnet
def symbolBase   = resolveAsset("bacnet_1_to_msv.logicsymbol")
def symbol1_20   = resolveAsset("bacnet_1_to_20_msv.logicsymbol")
def symbolOver20 = resolveAsset("bacnet_1_to_over_20_msv.logicsymbol")
def csvFile      = resolveAsset("NamingRules.csv")

// ==========================================
// UI CONTROLS & HELPERS
// ==========================================
JTextField txtObjectName = new JTextField("A1_Point", 15)
JTextField txtObjectID   = new JTextField("MSV:147", 10)
JTextField txtPrefix     = new JTextField("", 12)
JCheckBox  chkUseRules   = new JCheckBox("Use Naming Rules", true)

def makeRefSafe = { String s ->
    if (!s) return ""
    s = s.toLowerCase()
         .replaceAll(/[^a-z0-9]/, '_')
         .replaceAll(/__+/, '_')
         .replaceAll(/^_|_$/, '')
    if (s.matches("^\\d.*")) s = "_" + s
    return s 
}

def shortenMap = [:]
def loadNamingRules = {
    shortenMap.clear()
    if (csvFile.exists()) {
        csvFile.eachLine { line ->
            if (!line?.trim() || line.startsWith("#")) return
            def p = line.split(',')
            if (p.size() == 2) shortenMap.put(p[0].trim(), p[1].trim())
        }
    }
}
loadNamingRules()

// Applies CSV rules and strictly limits to 20 characters for EIKON
def eikonFormatStateText = { String str ->
    if (!str) return ""
    def s = str
    if (chkUseRules.isSelected()) {
        shortenMap.each { k, v ->
            s = s.replaceAll("(?i)\\b" + Pattern.quote(k) + "\\b", Matcher.quoteReplacement(v))
        }
    }
    s = s.trim()
    return s.length() > 20 ? s.substring(0, 20) : s
}

// Ref Name prefix applier
def getRefPrefix = { (txtPrefix?.getText() ?: "").trim() }
def formatRefName = { str ->
    String base = makeRefSafe(str)
    String pref = getRefPrefix()
    return makeRefSafe(pref ? (pref + "_" + base) : base)
}

// ==========================================
// GUI TABLE SETUP
// ==========================================
class EikonCellRenderer extends DefaultTableCellRenderer {
    @Override
    Component getTableCellRendererComponent(JTable table, Object value, boolean isSelected, boolean hasFocus, int row, int col) {
        Component c = super.getTableCellRendererComponent(table, value, isSelected, hasFocus, row, col)
        c.setBackground(isSelected ? table.getSelectionBackground() : Color.WHITE)
        c.setForeground(isSelected ? table.getSelectionForeground() : Color.BLACK)
        // Highlight BACnet text if somehow over 20 chars (though code prevents this)
        if (col == 2 && value?.toString()?.length() > 20) {
            c.setBackground(new Color(255, 100, 100))
        }
        return c
    }
}

int MAX_STATES = 1000
def columnNames = ["Value", "Raw State Text", "BACnet Text"]
// Initialize table with values 1 through 1000
def data = (1..MAX_STATES).collect { [it.toString(), "", ""] } as Object[][]
DefaultTableModel model = new DefaultTableModel(data, columnNames as Object[]) { 
    @Override boolean isCellEditable(int r, int c) { return c != 0 } 
}
JTable table = new JTable(model)
table.setDefaultRenderer(Object.class, new EikonCellRenderer())
table.setRowHeight(22)
table.getColumnModel().getColumn(0).setMaxWidth(50)
table.setCellSelectionEnabled(true)

// COPY/PASTE HANDLER (Adapted for 1000 rows)
table.addKeyListener(new KeyAdapter() {
    @Override
    void keyPressed(KeyEvent e) {
        int mask
        try { mask = Toolkit.getDefaultToolkit().getMenuShortcutKeyMaskEx() }
        catch (Throwable t) { try { mask = Toolkit.getDefaultToolkit().getMenuShortcutKeyMask() } catch (Throwable t2) { mask = java.awt.event.InputEvent.CTRL_DOWN_MASK } }
        
        if ((e.getModifiersEx() & mask) != 0 && e.getKeyCode() == KeyEvent.VK_C) {
            StringBuilder sbf = new StringBuilder()
            int[] rows = table.getSelectedRows(); int[] cols = table.getSelectedColumns()
            for (int r : rows) {
                for (int c : cols) {
                    def val = table.getValueAt(r, c)
                    sbf.append(val == null ? "" : val.toString())
                    if (c != cols[cols.length-1]) sbf.append("\t")
                }
                sbf.append("\n")
            }
            StringSelection sel = new StringSelection(sbf.toString())
            Toolkit.getDefaultToolkit().getSystemClipboard().setContents(sel, sel)
            e.consume()
        }
        if ((e.getModifiersEx() & mask) != 0 && e.getKeyCode() == KeyEvent.VK_V) {
            int rStart = table.getSelectedRow() == -1 ? 0 : table.getSelectedRow()
            int cStart = table.getSelectedColumn() == -1 ? 1 : table.getSelectedColumn()
            try {
                String cb = (String) Toolkit.getDefaultToolkit().getSystemClipboard().getContents(null).getTransferData(DataFlavor.stringFlavor)
                cb.split("\\r?\\n").eachWithIndex { line, i ->
                    if (!line?.trim()) return
                    if ((rStart + i) < MAX_STATES) {
                        String[] cells = line.split("\t")
                        cells.eachWithIndex { val, j ->
                            if ((cStart + j) < 3 && (cStart + j) > 0) {
                                model.setValueAt((val == null) ? "" : val.trim(), rStart + i, cStart + j)
                            }
                        }
                    }
                }
            } catch (Exception ex) { /* ignore */ }
            e.consume()
        }
    }
})

// Auto-fill BACnet Text from Raw State Text
model.addTableModelListener({ e ->
    if (e.getColumn() == 1) {
        int r = e.getFirstRow()
        Object val = model.getValueAt(r, 1)
        if (val != null) {
            SwingUtilities.invokeLater({
                model.setValueAt(eikonFormatStateText(val.toString()), r, 2)
            })
        }
    }
} as javax.swing.event.TableModelListener)

// Reapply rules to all rows when toggled
def reapplyRules = {
    for (int i = 0; i < MAX_STATES; i++) {
        def rObj = model.getValueAt(i, 1)
        if (rObj) {
            model.setValueAt(eikonFormatStateText(rObj.toString()), i, 2)
        }
    }
}
chkUseRules.addItemListener({ evt -> reapplyRules() } as java.awt.event.ItemListener)

// ==========================================
// GUI LAYOUT
// ==========================================
JTextArea statusLabel = new JTextArea("Ready\nAssets Dir: " + getBaseDir?.absolutePath, 4, 50)
statusLabel.setEditable(false); statusLabel.setBackground(new Color(240, 240, 240))

JTabbedPane tabs = new JTabbedPane()
JPanel msvPanel = new JPanel(new BorderLayout(5,5))
msvPanel.add(new JScrollPane(table), BorderLayout.CENTER)

JPanel regPanel = new JPanel(new GridBagLayout())
GridBagConstraints rbc = new GridBagConstraints()
rbc.insets = new Insets(4,6,4,6); rbc.anchor = GridBagConstraints.WEST; rbc.fill = GridBagConstraints.HORIZONTAL

rbc.gridx=0; rbc.gridy=0; regPanel.add(new JLabel("Object_Name:"), rbc)
rbc.gridx=1; rbc.gridy=0; rbc.weightx=0.2; regPanel.add(txtObjectName, rbc)
rbc.weightx=0

rbc.gridx=2; rbc.gridy=0; regPanel.add(new JLabel("Object ID:"), rbc)
rbc.gridx=3; rbc.gridy=0; rbc.weightx=0.2; regPanel.add(txtObjectID, rbc)
rbc.weightx=0

rbc.gridx=4; rbc.gridy=0; regPanel.add(chkUseRules, rbc)

rbc.gridx=0; rbc.gridy=1; regPanel.add(new JLabel("Ref Prefix:"), rbc)
rbc.gridx=1; rbc.gridy=1; rbc.gridwidth=3; rbc.weightx=1.0; regPanel.add(txtPrefix, rbc)

msvPanel.add(regPanel, BorderLayout.SOUTH)
tabs.addTab("MSV", msvPanel)

JButton okButton = new JButton("OK")
JButton fixOCRButton = new JButton("Fix OCR")
JButton clearButton = new JButton("Clear Labels")
JButton cancelButton = new JButton("Close")

JPanel buttonPanel = new JPanel()
buttonPanel.add(okButton); buttonPanel.add(fixOCRButton); 
buttonPanel.add(clearButton); buttonPanel.add(cancelButton)

JPanel bottomPanel = new JPanel(); 
bottomPanel.setLayout(new BoxLayout(bottomPanel, BoxLayout.Y_AXIS))
bottomPanel.add(new JScrollPane(statusLabel))
bottomPanel.add(buttonPanel)

JPanel mainPanel = new JPanel(new BorderLayout(5, 5)); 
mainPanel.setBorder(BorderFactory.createEmptyBorder(10, 10, 10, 10))
mainPanel.add(tabs, BorderLayout.CENTER)
mainPanel.add(bottomPanel, BorderLayout.SOUTH)

def frame = new JFrame("BACnet MSV Mapping V3.0.0")
frame.setContentPane(mainPanel); frame.setPreferredSize(new Dimension(800, 600))
frame.pack(); frame.setLocationRelativeTo(null); frame.setAlwaysOnTop(true); frame.setVisible(true)

// Button Actions
fixOCRButton.addActionListener({ 
    for (int i = 0; i < MAX_STATES; i++) { 
        def obj = model.getValueAt(i, 1)
        if (obj) model.setValueAt(obj.toString().replaceAll("(?<=[a-z0-9])(?=[A-Z])", " ").trim(), i, 1) 
    }
} as ActionListener)

clearButton.addActionListener({ 
    for (int i = 0; i < MAX_STATES; i++) { model.setValueAt("", i, 1); model.setValueAt("", i, 2) } 
} as ActionListener)

cancelButton.addActionListener({ frame.dispose() } as ActionListener)


// ==========================================
// THE MAIN EXECUTION LOGIC (V2.0.3 Core)
// ==========================================
okButton.addActionListener(new ActionListener() {
    public void actionPerformed(ActionEvent eventObj) {
        try {
            // Extract the formatted BACnet states from the table
            def allStates = []
            for (int i = 0; i < MAX_STATES; i++) {
                String bacnetText = model.getValueAt(i, 2)?.toString()?.trim()
                if (bacnetText) allStates << bacnetText
            }

            if (allStates.isEmpty()) {
                statusLabel.setText("Error: No states defined in table.")
                return
            }

            // ==========================================
            // STEP 1: Dynamic Append
            // ==========================================
            def stateChunks = allStates.collate(20) 
            def totalChunks = stateChunks.size()

            println "DEBUG: Initializing BACnet logic with ${totalChunks} symbol(s)..."

            if (totalChunks <= 1) {
                if (symbolBase.exists()) logic.append { symbol(symbolBase.absolutePath) }
            } else {
                if (symbol1_20.exists()) logic.append { symbol(symbol1_20.absolutePath) }
                (totalChunks - 1).times {
                    println "DEBUG: Appending BACnet expansion symbol #${it + 1}"
                    if (symbolOver20.exists()) logic.append { symbol(symbolOver20.absolutePath) }
                }
            }

            // ==========================================
            // STEP 2: Main Logic Execution
            // ==========================================
            def searchText = "MSV:888888888"
            def replaceText = txtObjectID.getText().trim()
            def nameSearch = "Object_Name"
            def nameReplace = txtObjectName.getText().trim()
            def searchMode = "14" 

            def X = 1  // [Inactive Text]
            def var1   // [Inactive Text]

            def descriptiveRef = formatRefName(nameReplace)
            def refSearch = searchText.toLowerCase().replace(' ', '_')

            println "DEBUG: --- Starting Global BACnet Scan (Stable V3.0.0) ---"

            int msvChunkIndex = 0
            int figureMatchCount = 0
            int ifgtpCounter = 0 
            int ifltpCounter = 0
            int subpCounter = 0 
            int statbCounter = 0 

            logic.microblocks {
                if (searchMode == "14") {
                    
                    // 1. Address Property
                    if (propNames.contains('address') && prop.'address'.contains(searchText)) {
                        prop.'address' = prop.'address'.replaceAll(searchText, replaceText)
                    }

                    // 2. Display Name & Description
                    if (propNames.contains('display name') && prop.'display name'.contains(nameSearch)) {
                        prop.'display name' = prop.'display name'.replaceAll(nameSearch, nameReplace)
                        if (propNames.contains('description')) { prop.'description' = prop.'description'.replaceAll(nameSearch, nameReplace) }

                        // 3. MSV State and Reference Name Chunking
                        if (getType() == "bmsvs") {
                            if (msvChunkIndex < totalChunks) {
                                prop.'state text' = stateChunks[msvChunkIndex].join('\n')
                                def suffix = "_msv_${msvChunkIndex + 1}"
                                prop.'reference name' = descriptiveRef + suffix
                                msvChunkIndex++
                            }
                        } else {
                            def currentRef = prop.'reference name'
                            def suffix = ""
                            if (currentRef.endsWith("_ani")) suffix = "_ani"
                            else if (currentRef.endsWith("_tnd")) suffix = "_tnd"
                            prop.'reference name' = descriptiveRef + suffix
                        }
                    }

                    // 4. Trip Point and Subtraction Constant Logic
                    if (getType() == "ifgtp" && propNames.contains('trip point')) {
                        ifgtpCounter++
                        if (ifgtpCounter > 1) {
                            float newThreshold = (ifgtpCounter - 1) * 20.0
                            prop.'trip point' = newThreshold
                            println "DEBUG: Updated ifgtp #${ifgtpCounter} Trip Point to ${newThreshold}"
                        }
                    }
                    
                    if (getType() == "ifltp" && propNames.contains('trip point')) {
                        ifltpCounter++
                        if (ifltpCounter > 1) {
                            float newThreshold = ((ifltpCounter - 1) * 20.0) + 21.0
                            prop.'trip point' = newThreshold
                            println "DEBUG: Updated ifltp #${ifltpCounter} Trip Point to ${newThreshold}"
                        }
                    }

                    if (getType() == "subp" && propNames.contains('constant')) {
                        subpCounter++
                        float newSubConstant = subpCounter * 20.0
                        prop.'constant' = newSubConstant
                        println "DEBUG: Updated subp #${subpCounter} Constant to ${newSubConstant}"
                    }

                    // 5. Binary Status (statb) Renaming
                    if (getType() == "statb" && propNames.contains('reference name')) {
                        if (prop.'reference name'.contains("object_identifier_bs")) {
                            statbCounter++
                            def suffix = "_bs_${statbCounter}"
                            prop.'reference name' = descriptiveRef + suffix
                            println "DEBUG: Updated statb #${statbCounter} Reference Name to ${prop.'reference name'}"
                        }
                    }
                }

                // --- PROTECTED INDIVIDUAL MODES ---
                else if (searchMode == "1" && propNames.contains('display name') && prop.'display name'.contains(searchText)) { prop.'display name' = prop.'display name'.replaceAll(searchText, replaceText) }
                else if (searchMode == "3" && propNames.contains('display name') && prop.'display name'.contains(searchText)) {
                    prop.'display name' = prop.'display name'.replaceAll(searchText, replaceText)
                    prop.'reference name' = prop.'reference name'.replaceAll(refSearch, replaceText.toLowerCase())
                }
                else if (searchMode == "4" && propNames.contains('address') && prop.'address'.contains(searchText)) {
                    prop.'address' = prop.'address'.replaceAll(searchText, replaceText)
                    prop.'reference name' = prop.'reference name'.replaceAll(refSearch, replaceText.toLowerCase())
                }
                else if (searchMode == "5" && propNames.contains('inactive text') && prop.'inactive text'.contains(searchText)) {
                    prop.'inactive text' = prop.'inactive text'.replaceAll(searchText, replaceText)
                }
                else if (searchMode == "6" && propNames.contains('active text') && prop.'active text'.contains(searchText)) {
                    prop.'active text' = prop.'active text'.replaceAll(searchText, replaceText)
                }
                else if (searchMode == "8" && propNames.contains('alarm text') && prop.'alarm text'.contains(searchText)) {
                    prop.'alarm text' = prop.'alarm text'.replaceAll(searchText, replaceText)
                    prop.'return text' = prop.'return text'.replaceAll(searchText, replaceText)
                }
                else if (searchMode == "2" && propNames.contains('reference name') && prop.'reference name'.contains(searchText)) {
                    prop.'reference name' = prop.'reference name'.replaceAll(searchText, replaceText)
                }
                else if (searchMode == "9" && propNames.contains('description') && prop.'description'.contains(searchText)) {
                    prop.'description' = prop.'description'.replaceAll(searchText, replaceText)
                }
                else if (searchMode == "12" && propNames.contains('object instance')) {
                    prop.'object instance' = X + prop.'object instance'
                }
                else if (searchMode == "11" && propNames.contains('property page text') && prop.'property page text'.contains(searchText)) {
                    prop.'property page text' = prop.'property page text'.replaceAll(searchText, replaceText)
                }
            }

            // --- PART 3: Label & Figure Cleanup ---
            if (searchMode == "7" || searchMode == "14") {
                for (def label : logic.labels()) {
                    if (label.name.contains(searchText)) { label.rename(label.name.replaceAll(searchText, replaceText)) }
                    if (label.name.contains(nameSearch)) { label.rename(label.name.replaceAll(nameSearch, nameReplace)) }
                }
            }

            if (searchMode == "10" || searchMode == "14") {
                logic.figures {
                    if (getType().equals('text-figure')) {
                        if (text.contains(searchText)) { text = text.replaceAll(searchText, replaceText) }
                        if (text.contains(nameSearch)) { text = text.replaceAll(nameSearch, nameReplace) }
                        
                        if (text.contains("MSV 21-40")) {
                            figureMatchCount++
                            int startRange = (figureMatchCount * 20) + 1
                            int endRange = (figureMatchCount + 1) * 20
                            text = "MSV ${startRange}-${endRange}"
                            println "DEBUG: Updated Text Figure to MSV ${startRange}-${endRange}"
                        }
                    }
                }
            }

            // --- PART 4: Mode 13 Preserved ---
            if (searchMode == "13") {
                Integer stopY = null
                def aLabels = []
                logic.labels() { if (name == "NA") { stopY = getY() } }
                if (stopY == null) { stopY = Integer.MAX_VALUE }
                logic.labels() {
                    if (name ==~ /A\d{3}/ && getY() < stopY) {
                        aLabels << [label: delegate, x: getX(), y: getY()]
                    }
                }
                aLabels.sort { a, b -> a.y == b.y ? a.x <=> b.x : a.y <=> b.y }
                int counter = 1
                aLabels.each { entry ->
                    if (counter > 999) return
                    entry.label.rename(String.format("A%03d", counter))
                    counter++
                }
            }

            statusLabel.setText("Success! Appended ${totalChunks} symbols and processed ${allStates.size()} states.")
            println "DEBUG: Done."
            
        } catch (Exception ex) {
            statusLabel.setText("Error: " + (ex?.message ?: ex?.toString()))
            println "ERROR: " + ex.toString()
        }
    }
})
